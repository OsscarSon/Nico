{
  "name": "nico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:b": "node scripts/smoke-b.mjs",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "smoke:academy": "node scripts/smoke-academy.mjs",
    "smoke:foundation": "node scripts/smoke-foundation.mjs",
    "smoke:network": "node scripts/smoke-network.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "smoke:p2": "node scripts/smoke-p2.mjs",
    "smoke:p2-final": "node scripts/smoke-p2-final.mjs",
    "smoke:p3a": "node scripts/smoke-p3a.mjs",
    "smoke:intermediate": "node scripts/smoke-intermediate.mjs",
    "smoke:p3b": "node scripts/smoke-p3b.mjs",
    "smoke:c": "node scripts/smoke-c.mjs",
    "smoke:d": "node scripts/smoke-d.mjs && node scripts/smoke-d-rest.mjs",
    "smoke:e": "node scripts/smoke-e.mjs",
    "smoke:f": "node scripts/smoke-f.mjs",
    "smoke:ab-courses": "node scripts/smoke-ab-courses.mjs",
    "smoke:academy2": "node scripts/smoke-academy2.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "acorn": "^8.14.0",
    "codemirror": "^6.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "marked": "^18.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
